NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/marketsphere
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173

# Cloudinary (optional – local uploads are used when empty)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional – demo payment mode is used when empty)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Nodemailer SMTP (optional – emails are logged to console when empty)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=MarketSphere <no-reply@marketsphere.test>

# Marketplace defaults
DEFAULT_COMMISSION_RATE=10
DEFAULT_DELIVERY_CHARGE=49
DEFAULT_TAX_RATE=5
